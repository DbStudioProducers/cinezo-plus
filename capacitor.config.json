{
  "appId": "com.cinezoplus",
  "appName": "CineZo+",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "plugins": {
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#0b1021"
    },
    "App": {
      "logsEnabled": true
    }
  },
  "android": {
    "backgroundColor": "#0b1021",
    "allowMixedContent": true,
    "captureInput": true
  },
  "ios": {
    "backgroundColor": "#0b1021",
    "contentInset": "automatic"
  }
}
